// ============================================================
//  firestore.rules
//  Delivo — Firestore Security Rules
//
//  HOW TO DEPLOY:
//    firebase deploy --only firestore:rules
//  OR paste directly into:
//    Firebase Console → Firestore → Rules tab
//
//  DATABASE STRUCTURE THIS EXPECTS:
//    /stores/{storeId}         — public store listings
//    /stores/{storeId}/menu/{itemId} — public menu items
//    /categories/{categoryId}  — public categories
//    /offers/{offerId}         — public offers/banners
//    /users/{userId}           — private user profiles
//    /orders/{orderId}         — orders (owner + admin only)
//    /settings/{doc}           — admin-only config
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helper functions ──────────────────────────────

    // Is the request from a signed-in user?
    function isAuth() {
      return request.auth != null;
    }

    // Is the signed-in user the owner of this document?
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Is the signed-in user an admin?
    // Admins have a custom claim set via Firebase Admin SDK (server-side).
    // Never set this from the client.
    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    // Is the incoming data size reasonable? (prevent data bombs)
    function isSizeOk() {
      return request.resource.data.size() < 50;
    }

    // Does the string field look safe? (no HTML/script injection)
    function isCleanString(val) {
      return val is string
          && val.size() <= 500
          && !val.matches('.*<script.*')
          && !val.matches('.*javascript:.*')
          && !val.matches('.*on\\w+=.*');
    }

    // ── /stores — public read, admin write ───────────────────
    match /stores/{storeId} {
      allow read:  if true;          // anyone can browse stores
      allow write: if isAdmin();     // only admin can add/edit stores

      // /stores/{storeId}/menu — public read, admin write
      match /menu/{itemId} {
        allow read:  if true;
        allow write: if isAdmin();
      }
    }

    // ── /categories — public read, admin write ────────────────
    match /categories/{categoryId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── /offers — public read, admin write ────────────────────
    match /offers/{offerId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── /users/{userId} — private, owner or admin only ────────
    match /users/{userId} {
      // Only the owner can read their own profile
      allow read:   if isOwner(userId) || isAdmin();

      // Owner can create their own doc (on first sign-up)
      allow create: if isOwner(userId)
                    && isSizeOk()
                    && isCleanString(request.resource.data.name)
                    && isCleanString(request.resource.data.phone);

      // Owner can update only safe fields — never role or admin flag
      allow update: if isOwner(userId)
                    && isSizeOk()
                    && !('role'  in request.resource.data)
                    && !('admin' in request.resource.data)
                    && !('uid'   in request.resource.data);

      // Only admin can delete a user document
      allow delete: if isAdmin();
    }

    // ── /orders/{orderId} — owner or admin only ───────────────
    match /orders/{orderId} {
      // Owner can read their own orders; admin can read all
      allow read: if isAuth()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Authenticated user can place a new order
      allow create: if isAuth()
                    && isSizeOk()
                    && request.resource.data.userId == request.auth.uid
                    // Must have required fields
                    && 'items'     in request.resource.data
                    && 'total'     in request.resource.data
                    && 'createdAt' in request.resource.data
                    // Total must be a positive number
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    // Status must start as 'pending' — client cannot self-approve
                    && request.resource.data.status == 'pending';

      // Only admin can update orders (change status, etc.)
      allow update: if isAdmin();

      // Nobody can delete orders (audit trail)
      allow delete: if false;
    }

    // ── /settings — admin only, never client-readable ─────────
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Catch-all: deny everything not explicitly allowed ─────
    //   This is the default, but stated explicitly for clarity.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
